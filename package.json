{
  "name": "gab-espineli-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run build && npm run db:local && concurrently -k -n web,api \"vite\" \"wrangler dev --local --ip 127.0.0.1 --port 8787\"",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "node scripts/test-api.mjs",
    "db:local": "wrangler d1 migrations apply portfolio-golf --local",
    "db:remote": "wrangler d1 migrations apply portfolio-golf --remote --config wrangler.api.jsonc",
    "deploy": "npm run deploy:api",
    "deploy:api": "wrangler deploy --config wrangler.api.jsonc"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
